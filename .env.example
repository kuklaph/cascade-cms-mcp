# Cascade CMS API credentials (required)
CASCADE_API_KEY=your_api_key_here
CASCADE_URL=https://tenant.cascadecms.com/api/v1/

# Request timeout in milliseconds (optional, default: 30000)
# CASCADE_TIMEOUT_MS=30000

# Logical Cascade API operations admitted per cohort (optional, integer 1-5000; default: 10)
# CASCADE_MAX_CONCURRENT_REQUESTS=10

# Delay between queued logical-operation cohorts in milliseconds (optional, integer 0-2147483647; default: 3000)
# A value of 0 removes the pause but retains the all-settled cohort barrier.
# CASCADE_REQUEST_BATCH_DELAY_MS=3000
